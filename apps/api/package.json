{
  "name": "@fair-value-radar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fair Value Radar - 後端 API 服務（Fastify + TypeScript）",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
