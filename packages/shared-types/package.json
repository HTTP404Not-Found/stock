{
  "name": "@fair-value-radar/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "跨前後端的 TypeScript 型別定義（純型別，無 runtime）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
