# ============================================================================
# Fair Value Radar - 環境變數範例檔
# ============================================================================
# 複製本檔為 .env 並填入實際值：
#   cp .env.example .env
#
# ⚠️ 絕對不要把 .env commit 到 git（已被 .gitignore 排除）
# ⚠️ API Key / Token 屬於秘密，洩漏等同於授權他人存取你的帳號
# ============================================================================

# --- LLM 客戶端（OpenAI 兼容 API） ---
# base URL 指向任何 OpenAI 兼容服務（預設為本專案使用的服務）
OPENAI_BASE_URL=https://api.minimax.io/v1
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=MiniMax-M2.7

# --- SearXNG（本機搜尋引擎，給新聞 + LLM 解讀模組用）---
SEARXNG_URL=http://localhost:8888

# --- yfinance 資料源節流 ---
# 每次請求之間的毫秒數，避免被 Yahoo Finance 限流
YFINANCE_RATE_LIMIT_MS=200

# --- 服務埠號 ---
API_PORT=4000
WEB_PORT=3000

# --- SQLite 資料庫 ---
# Docker 容器內對應 volume ./data:/app/data
DATABASE_PATH=/app/data/fair-value-radar.db

# --- 日誌 ---
# 可選：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- 時區 ---
# 影響排程任務、報價時間、DB 時間戳記格式
TZ=Asia/Taipei
